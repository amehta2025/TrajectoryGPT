{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--app-dir",
        "backend",
        "--port",
        "8000"
      ],
      "env": {
        "ALLOW_PLANTED_OVERCLAIM": "1"
      },
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "backend-alt",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--app-dir",
        "backend",
        "--port",
        "8010"
      ],
      "env": {
        "ALLOWED_ORIGINS": "http://localhost:5180"
      },
      "port": 8010,
      "autoPort": false
    },
    {
      "name": "frontend-alt",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5180",
        "--strictPort"
      ],
      "env": {
        "VITE_API_URL": "http://localhost:8010"
      },
      "port": 5180,
      "autoPort": false
    },
    {
      "name": "backend-replay",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--app-dir",
        "backend",
        "--port",
        "8000"
      ],
      "env": {
        "APP_MODE": "replay",
        "META_API_KEY": "",
        "BASETEN_API_KEY": ""
      },
      "port": 8000,
      "autoPort": false
    },
    {
      "name": "backend-sweep",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--app-dir", "backend", "--port", "8000"],
      "env": {
        "RATE_LIMIT_PLAN_PER_HOUR": "1000", "RATE_LIMIT_PLAN_PER_SESSION": "1000",
        "RATE_LIMIT_FIGURE_PER_HOUR": "1000", "RATE_LIMIT_FIGURE_PER_SESSION": "1000",
        "RATE_LIMIT_RUN_PER_HOUR": "1000", "RATE_LIMIT_RUN_PER_SESSION": "1000",
        "DAILY_LLM_BUDGET_USD": "6.1", "SKIP_VERIFIER": "1"
      },
      "port": 8000,
      "autoPort": false
    },
    {
      "name": "backend-sweep-verify",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--app-dir", "backend", "--port", "8000"],
      "env": {
        "RATE_LIMIT_PLAN_PER_HOUR": "1000", "RATE_LIMIT_PLAN_PER_SESSION": "1000",
        "RATE_LIMIT_FIGURE_PER_HOUR": "1000", "RATE_LIMIT_FIGURE_PER_SESSION": "1000",
        "RATE_LIMIT_RUN_PER_HOUR": "1000", "RATE_LIMIT_RUN_PER_SESSION": "1000",
        "DAILY_LLM_BUDGET_USD": "6.1"
      },
      "port": 8000,
      "autoPort": false
    },
    {
      "name": "backend-passcode",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--app-dir",
        "backend",
        "--port",
        "8000"
      ],
      "env": {
        "DEMO_PASSCODE": "local-test-pass"
      },
      "port": 8000,
      "autoPort": false
    }
  ]
}
