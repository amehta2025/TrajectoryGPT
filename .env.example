# Copy to .env and fill in. Never commit .env.
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
# META_MODEL: muse-spark-1.3-contributor is dev only; every deploy uses muse-spark-1.3
META_MODEL=muse-spark-1.3-contributor
META_VERIFIER_MODEL=muse-wonder-1.0
META_ASR_MODEL=muse-voice-transcribe-1.0
META_REASONING_EFFORT=
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026
MODEL_PROVIDER=meta
APP_MODE=live
DAILY_LLM_BUDGET_USD=
DEMO_PASSCODE=
# Dev only: lets a run plant an overclaiming finding for the verifier demo. Never set on a deploy.
ALLOW_PLANTED_OVERCLAIM=
# Rate limits per client IP per hour (defaults 10 / 10 / 3). TRUSTED_PROXY_HOPS only behind proxies we control.
RATE_LIMIT_PLAN_PER_HOUR=
RATE_LIMIT_RUN_PER_HOUR=
RATE_LIMIT_SANDBOX_PER_HOUR=
RATE_LIMIT_VOICE_PER_HOUR=
RATE_LIMIT_FIGURE_PER_HOUR=
RATE_LIMIT_REPLAY_PER_HOUR=
RATE_LIMIT_PASSCODE_FAIL_PER_HOUR=
TRUSTED_PROXY_HOPS=
# Set to 1 on the deployed app only: the report's clean-sandbox check (Modal Sandbox).
SANDBOX_ENABLED=
