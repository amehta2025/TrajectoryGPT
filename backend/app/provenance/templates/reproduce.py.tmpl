#!/usr/bin/env python
"""Reproduce TrajectoryGPT run @@RUN_ID@@ from scratch.

Question: @@QUESTION@@
Dataset:  @@DATASET@@

This file was generated by TrajectoryGPT's own code from a fixed template (never written by a language
model). It bundles, verbatim, the analysis code the run used (stats, contacts, the tool layer), fetches the
public dataset, replays every tool call of the run in order with the same parameters and seed, writes one
plot per result, and prints the recomputed numbers next to the values embedded from the run.

Requires Python 3.11+ and: @@REQUIREMENTS@@

    python reproduce_@@RUN_ID@@.py                    # downloads the dataset into ./reproduce_data
    python reproduce_@@RUN_ID@@.py --data-dir DIR     # use an existing MDAnalysisData directory

Exit code 0 when every value matches within tolerance (relative 1e-6, absolute 1e-9).
"""
import argparse
import json
import math
import os
import sys
import tempfile
from pathlib import Path

RUN_ID = "@@RUN_ID@@"
# What the run recorded: approved plan, the tool calls in order, and every stored value (placeholders resolve to these).
RUN = json.loads(@@RUN_JSON@@)
# The dataset configuration the run used (config/dataset.yaml at export time).
CONFIG = json.loads(@@CONFIG_JSON@@)
# TrajectoryGPT's analysis code, verbatim from the repository (path -> source).
SOURCES = @@SOURCES@@

CONFIG_MODULE = '''"""Generated for the reproduce script: the run's dataset config, data and cache directories from the environment."""
import json
import os
from pathlib import Path

_CONFIG = json.loads(os.environ["REPRO_CONFIG_JSON"])
CACHE_DIR = Path(os.environ["REPRO_CACHE_DIR"])
DATA_DIR = Path(os.environ["REPRO_DATA_DIR"])
REPO_ROOT = CACHE_DIR.parent
CONFIG_PATH = None


def load_config() -> dict:
    return _CONFIG


def dataset_config(dataset: str) -> dict:
    datasets = _CONFIG["datasets"]
    if dataset not in datasets:
        raise ValueError(f"Unknown dataset {dataset!r}. Known: {sorted(datasets)}")
    return datasets[dataset]
'''
REL, ABS = 1e-6, 1e-9


def install(root: Path) -> None:
    """Write the bundled code as an importable package under root."""
    for rel, src in {**SOURCES, "app/config.py": CONFIG_MODULE}.items():
        p = root / rel
        p.parent.mkdir(parents=True, exist_ok=True)
        p.write_text(src, encoding="utf-8")
    sys.path.insert(0, str(root))


def close(a, b) -> bool:
    if isinstance(a, (list, tuple)) and isinstance(b, (list, tuple)):
        return len(a) == len(b) and all(close(x, y) for x, y in zip(a, b))
    if isinstance(a, bool) or isinstance(b, bool) or a is None or b is None or isinstance(a, str) or isinstance(b, str):
        return a == b
    if isinstance(a, (int, float)) and isinstance(b, (int, float)):
        if math.isnan(a) and math.isnan(b):
            return True
        return abs(a - b) <= max(ABS, REL * max(abs(a), abs(b)))
    return a == b


def show(v) -> str:
    if isinstance(v, float):
        return f"{v:.6g}"
    if isinstance(v, (list, tuple)):
        return "[" + ", ".join(show(x) for x in v) + "]"
    return str(v)


def main() -> int:
    for stream in (sys.stdout, sys.stderr):  # Windows consoles default to cp1252, which cannot print "Å"
        stream.reconfigure(encoding="utf-8", errors="replace")
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--data-dir", default="reproduce_data", help="MDAnalysisData directory (the dataset is downloaded here)")
    ap.add_argument("--out", default=f"reproduce_{RUN_ID}_out", help="where plots and the recomputed values go")
    a = ap.parse_args()
    out = Path(a.out).resolve()
    out.mkdir(parents=True, exist_ok=True)
    os.environ.update(REPRO_CONFIG_JSON=json.dumps(CONFIG), REPRO_DATA_DIR=str(Path(a.data_dir).resolve()),
                      REPRO_CACHE_DIR=str(out / "cache"))
    install(Path(tempfile.mkdtemp(prefix="tgpt_reproduce_")))

    from app.agent.tools import ApprovedPlan, RunState, library_versions, run_tool
    from app.provenance.plots import plot_result
    from app.science.contacts import dataset_hashes

    plan = ApprovedPlan(**RUN["plan"])
    print(f"Run {RUN_ID}: {RUN['question']}")
    print(f"Dataset {plan.dataset}; groups {plan.group_a}-{plan.group_b}; cutoff {plan.cutoff} Å; windows {plan.window_a} {plan.window_b}")
    hashes = dataset_hashes(plan.dataset)
    same_data = hashes == RUN["dataset_hashes"]
    print(f"Dataset files: {'same as the run' if same_data else 'DIFFERENT from the run'} {hashes}")
    versions = library_versions()
    if versions != RUN["library_versions"]:
        print(f"Note: library versions differ from the run: now {versions}, run {RUN['library_versions']}")

    state = RunState(plan)
    for call in RUN["calls"]:
        res = run_tool(state, call["tool"], call["arguments"])
        print(f"  {res['provenance_id']:<4} {call['tool']:<22} {res['status']}")
        if res["provenance_id"] != call["provenance_id"] or res["status"] != call["status"]:
            print(f"    expected {call['provenance_id']} {call['status']}")

    time_label = CONFIG["datasets"][plan.dataset]["time_label"]
    for pid, res in state.results.items():
        fig = plot_result(res, time_label) if res["status"] == "ok" else None
        if fig is not None:
            fig.savefig(out / f"{pid}_{res['tool']}.png", dpi=110, bbox_inches="tight")

    rows, n_ok, n_all = [], 0, 0
    recomputed = {}
    for pid, expected in RUN["values"].items():
        got = state.results.get(pid, {}).get("values", {})
        recomputed[pid] = {k: v["v"] for k, v in got.items()}
        for name, v in expected.items():
            new = got.get(name, {}).get("v", "missing")
            ok = close(v, new)
            n_all += 1
            n_ok += ok
            if f"{pid}.{name}" in RUN["cited"] or not ok:
                rows.append((f"{pid}.{name}", show(v), show(new), "match" if ok else "MISMATCH"))
    (out / "recomputed_values.json").write_text(json.dumps(recomputed, indent=1), encoding="utf-8")

    print("\nValues cited in the report (and any mismatch):")
    w = max([len(r[0]) for r in rows] + [5])
    print(f"  {'value':<{w}}  {'run':>22}  {'recomputed':>22}")
    for name, v, new, verdict in rows:
        print(f"  {name:<{w}}  {v:>22}  {new:>22}  {verdict}")
    print(f"\n{n_ok} of {n_all} stored values match (tolerance relative {REL:g}, absolute {ABS:g}).")
    print(f"Plots and recomputed_values.json in {out}")
    ok = n_ok == n_all and same_data
    print("REPRODUCED" if ok else "NOT REPRODUCED")
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
